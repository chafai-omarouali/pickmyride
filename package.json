{
  "name": "pickmyride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PickMyRide — platform voor vooraf geboekte taxiritten met gesloten biedingen",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:local": "bash scripts/local-db.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "playwright": "^1.50.0"
  }
}
