# Kopieer naar .env en vul in. Zet .env NOOIT in git.
APP_ENV=development                 # development | test | production
PORT=3000
BASE_URL=http://localhost:3000      # in productie: https://… (zet dan ook Secure-cookies en HSTS aan)
TRUST_PROXY=false                   # true achter een reverse proxy (X-Forwarded-For)

# Database: de app verbindt als pickmyride_app (geen superuser), migraties als eigenaar
DATABASE_URL=postgres://pickmyride_app@127.0.0.1:5433/pickmyride
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5433/pickmyride

# Geheimen (genereer bijv. met: openssl rand -base64 32)
SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Demo: demo-betaalomgeving + ontwikkel-mailbox. Nooit in productie.
DEMO_MODE=true

# Betalingen: demo | mollie. Alleen test_-sleutels; live vereist ALLOW_LIVE_PAYMENTS=true (expliciete toestemming)
PAYMENT_PROVIDER=demo
MOLLIE_API_KEY=
# ALLOW_LIVE_PAYMENTS=false

# Bellen tussen klant en bedrijf (afgeschermde nummers): geen | demo | twilio
# geen = niet aangesloten (app meldt dit), demo = simulatie (alleen DEMO_MODE), twilio = echte gesprekken
CALL_PROVIDER=geen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
CALL_PLATFORM_NUMBER=                # Nederlands nummer bij de provider, getoond als afzender (E.164, bijv. +3120…)

# Adressen/routes: geen | pdok
GEO_PROVIDER=geen

# E-mail: outbox (alleen opslaan) | smtp (nog aan te sluiten)
MAIL_MODE=outbox

STORAGE_DIR=./storage/private
